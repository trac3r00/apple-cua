{
	"name": "@apple-cua/core",
	"version": "0.1.0",
	"type": "module",
	"description": "Platform-abstracted computer-use interfaces",
	"keywords": ["computer-use", "macos", "accessibility", "screencapturekit", "coregraphics", "koffi"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/apple-cua.git",
		"directory": "packages/core"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./stop": {
			"types": "./dist/platform/stop-switch.d.ts",
			"import": "./dist/platform/stop-switch.js"
		},
		"./isolated": {
			"types": "./dist/platform/isolated.d.ts",
			"import": "./dist/platform/isolated.js"
		}
	},
	"scripts": {
		"build": "pnpm run build:native && tsgo -p tsconfig.build.json",
		"build:ts": "tsgo -p tsconfig.build.json",
		"build:native": "./native/build.sh",
		"typecheck": "tsgo --noEmit",
		"test": "bun test --isolate --parallel=4"
	},
	"files": [
		"dist",
		"vendor",
		"native/sckit.m",
		"native/build.sh",
		"native/build-inputs.sha256",
		"native/libsckit.dylib",
		"native/cursor-overlay.m",
		"native/cursor-overlay"
	],
	"dependencies": {
		"get-windows": "9.3.0",
		"koffi": "2.16.2",
		"node-mac-permissions": "2.5.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"@types/node": "^20.0.0"
	}
}
