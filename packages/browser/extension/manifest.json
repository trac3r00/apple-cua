{
	"manifest_version": 3,
	"name": "Browser-Skill-OmO",
	"version": "0.1.0",
	"key": "",
	"minimum_chrome_version": "125",
	"permissions": ["debugger", "tabs", "storage", "alarms", "nativeMessaging"],
	"host_permissions": ["http://127.0.0.1/*"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_page": "options.html",
	"action": {
		"default_popup": "popup.html",
		"default_title": "Browser-Skill-OmO"
	}
}
