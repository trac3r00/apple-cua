{
	"name": "@opencua/browser",
	"version": "0.1.0",
	"type": "module",
	"description": "Compact Chromium browser automation with the opencua stop gate",
	"bin": {
		"cua-browser": "./dist/cli.js",
		"cua-browser-mcp": "./dist/server.js",
		"apple-cua-browser": "./dist/cli.js",
		"apple-cua-browser-mcp": "./dist/server.js"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo --noEmit",
		"test": "bun test --isolate",
		"verify:browser": "node scripts/verify.mjs"
	},
	"dependencies": {
		"@opencua/core": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"ws": "8.20.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/ws": "^8.5.13"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/opencua.git",
		"directory": "packages/browser"
	},
	"files": ["dist", "extension", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
