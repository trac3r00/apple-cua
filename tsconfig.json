{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"paths": {
			"@opencua/agent": ["./packages/agent/src/index.ts"],
			"@opencua/browser": ["./packages/browser/src/index.ts"],
			"@opencua/core": ["./packages/core/src/index.ts"],
			"@opencua/core/isolated": ["./packages/core/src/platform/isolated.ts"],
			"@opencua/core/light": ["./packages/core/src/light.ts"],
			"@opencua/core/stop": ["./packages/core/src/platform/stop-switch.ts"],
			"@opencua/test-support": ["./scripts/test-support/bun.ts"]
		},
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["packages/*/src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
