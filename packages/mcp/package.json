{
	"name": "@opencua/mcp",
	"version": "0.1.0",
	"type": "module",
	"description": "Model Context Protocol server for macOS computer control",
	"keywords": ["mcp", "model-context-protocol", "computer-use", "macos", "automation"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/opencua.git",
		"directory": "packages/mcp"
	},
	"bin": {
		"opencua-mcp": "./dist/server.js",
		"apple-cua-mcp": "./dist/server.js",
		"opencua-isolated-mcp": "./dist/isolated-server.js",
		"apple-cua-isolated-mcp": "./dist/isolated-server.js"
	},
	"scripts": {
		"build": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo --noEmit",
		"test": "bun test --isolate --parallel=4",
		"prepack": "node scripts/copy-skills.mjs"
	},
	"dependencies": {
		"@opencua/agent": "workspace:*",
		"@opencua/browser": "workspace:*",
		"@opencua/core": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": ["dist", "!dist/opencua-mcp.app", "!dist/appicon.iconset", "assets", "skills", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	}
}
