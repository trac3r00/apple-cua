{
	"name": "apple-cua",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Native macOS computer-use control with cua-style platform abstractions",
	"keywords": ["computer-use", "macos", "automation", "mcp", "accessibility", "coregraphics", "agent"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trac3r00/apple-cua.git"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"typecheck:tests": "tsgo --noEmit -p tsconfig.test.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "scripts/bun-test.sh packages scripts/bench-v2 scripts/preflight.test.mjs scripts/test-support",
		"test:watch": "bun test --watch",
		"test:browser:bun": "bun test --isolate packages/browser",
		"smoke:browser:bun": "bun scripts/bun-browser-smoke.mjs",
		"check": "biome check . && pnpm -r typecheck && pnpm typecheck:tests && pnpm test",
		"setup": "./scripts/setup.sh",
		"doctor": "node packages/cli/dist/cli.js doctor",
		"test:scripts": "bun test --isolate scripts/bench-v2 scripts/preflight.test.mjs scripts/test-support",
		"test:bench-v3": "bun test --isolate scripts/bench-v3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "1.4.4",
		"@types/node": "^22.10.2",
		"@typescript/native-preview": "^7.0.0-dev.20260513.1",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "pnpm@10.30.2"
}
